# ==============================================================================
# PharmaGuard Environment Configuration Template
# Copy to .env and configure secret keys prior to deployment
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173

# Core Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=8h
ALLOW_PUBLIC_REGISTRATION=false
# Auto-seed demo accounts/reports only when NODE_ENV is development/test AND AUTO_SEED=true
AUTO_SEED=false
# SMART-on-FHIR sandbox endpoints are disabled in production unless explicitly set to true
SMART_SANDBOX_ENABLED=false

# Field-Level PHI Encryption (AES-256-GCM 32-byte key)
PHI_ENCRYPTION_KEY=replace_with_a_secure_32_byte_aes_key_for_phi_encryption

# Database & Cache Infrastructure
MONGO_URI=mongodb://localhost:27017/pharmaguard
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# Machine Learning Service & LLM Configuration
ML_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-8b
LLM_API_KEY=
QDRANT_COLLECTION=drug_label_chunks
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=5
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=
QDRANT_URL=http://localhost:6333
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_LIVE_OPENFDA=false
ALLOW_BUILTIN_REFERENCE_CORPUS=false
DEID_REQUIRE_NER=true


